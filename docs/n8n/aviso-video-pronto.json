{
  "name": "Lyric video: enviar música e avisar quando ficar pronta",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Gerar lyric video",
        "formDescription": "Envie só músicas suas ou com autorização. O vídeo leva alguns minutos.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "audio",
              "fieldType": "file",
              "acceptFileTypes": ".mp3",
              "requiredField": true
            },
            {
              "fieldLabel": "lyrics",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "atalho",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "TikTok"
                  },
                  {
                    "option": "YouTube"
                  },
                  {
                    "option": "Full"
                  }
                ]
              }
            },
            {
              "fieldLabel": "autorizacao",
              "fieldType": "text",
              "placeholder": "Digite SIM para confirmar que a música é sua ou que você tem autorização",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "formulario",
      "name": "Enviar música",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "webhookId": "3f1c9e2a-7b4d-4c8e-9a61-2d5f0b7e8c10"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "autorizacao-sim",
              "leftValue": "={{ $json.autorizacao }}",
              "rightValue": "SIM",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "confirma",
      "name": "Autorização confirmada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.server }}/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "audio",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "audio"
            },
            {
              "name": "lyrics",
              "value": "={{ $json.lyrics }}"
            },
            {
              "name": "confirm",
              "value": "true"
            },
            {
              "name": "style",
              "value": "karaoke"
            },
            {
              "name": "background",
              "value": "gradient"
            },
            {
              "name": "format",
              "value": "={{ $json.format }}"
            },
            {
              "name": "cuts",
              "value": "={{ $json.cuts }}"
            }
          ]
        },
        "options": {}
      },
      "id": "enviar",
      "name": "Enviar para o servidor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": null,
          "name": "Senha do servidor (X-Access-Token)"
        }
      }
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 30,
        "unit": "seconds"
      },
