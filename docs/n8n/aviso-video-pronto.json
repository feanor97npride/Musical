    {
      "parameters": {
        "chatId": "COLE_O_ID_DO_CHAT",
        "text": "=Passaram cerca de 20 minutos e o envio {{ $('Guardar envio').item.json.id }} ({{ $('Guardar envio').item.json.format === 'horizontal' ? '16:9' : '9:16' }}) ainda não ficou pronto. Confira o PC: o servidor pode ter reiniciado, e nesse caso o envio se perde."
      },
      "id": "avisa-tempo",
      "name": "Avisar tempo esgotado",
