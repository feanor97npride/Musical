              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "erro",
      "name": "Erro?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
