    {
      "parameters": {
        "jsCode": "// Endereço do servidor (o túnel do PC): é o único lugar onde ele aparece neste fluxo.\nconst SERVER = \"https://whimsical.musicas.space\";\nconst shortcuts = {\n  TikTok: [{ format: \"vertical\", cuts: \"90\" }],\n  YouTube: [{ format: \"horizontal\", cuts: \"\" }],\n  Full: [{ format: \"horizontal\", cuts: \"\" }, { format: \"vertical\", cuts: \"90\" }],\n};\nconst base = $input.first();\nconst plans = shortcuts[base.json.atalho] || shortcuts.TikTok;\nreturn plans.map((plan) => ({ json: { ...base.json, ...plan, server: SERVER }, binary: base.binary, pairedItem: { item: 0 } }));"
      },
      "id": "montar",
      "name": "Montar envios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
