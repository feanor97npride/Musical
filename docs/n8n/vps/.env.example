# Copie para .env no VPS (sem o .example) e preencha. O .env real nunca vai para o Git.
N8N_HOST=n8n.SEU-DOMINIO
WEBHOOK_URL=https://n8n.SEU-DOMINIO/
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
# segredo do n8n: gere com `openssl rand -hex 32` e guarde num lugar seguro. Trocar depois apaga as credenciais salvas.
N8N_ENCRYPTION_KEY=TROQUE_POR_UMA_CHAVE_LONGA
