THEME_API_KEY=
THEME_MODEL=claude-haiku-5-5
# modelo que escreve a letra a partir do contexto (usa a mesma THEME_API_KEY)
LYRICS_MODEL=claude-sonnet-5-5
WHISPER_MODEL=small
# web: senha que a página pede (vazio = sem senha, só para uso local)
ACCESS_TOKEN=
# web: sites que podem chamar o servidor de outro endereço, separados por vírgula (ex.: a página no Cloudflare Pages)
ALLOWED_ORIGINS=
# iniciador (Windows): endereço fixo do site no Cloudflare Pages, sem barra no final (ex.: https://app.seu-dominio.com)
SITE_URL=
# iniciador: porta do servidor local (padrão 8000)
# PORT=8000
# render: número de processos (vazio = padrão do Remotion)
# RENDER_CONCURRENCY=
# render: caminho de um Chrome ou headless shell já instalado (vazio = o do Remotion)
# BROWSER_EXECUTABLE=
# túnel fixo (Cloudflare): token do túnel criado no painel. É uma senha: não mande para ninguém
TUNNEL_TOKEN=
# endereço fixo do túnel, sem https:// (ex.: meu-servidor.seudominio.com)
TUNNEL_HOSTNAME=
# biblioteca (Google Drive para computador): pasta de entrada, com uma subpasta por música (MP3, TXT e imagem opcional)
# DRIVE_INPUT_DIR=
# biblioteca: pasta de saída, onde cada música pronta é copiada (uma subpasta por música)
# DRIVE_OUTPUT_DIR=
# Drive automático: 1 = gera sozinho as músicas novas da pasta de entrada. Ligar é declarar que tudo o que entra na pasta é seu ou autorizado
# DRIVE_AUTO=
# atalho do Drive automático: full (16:9 inteiro e 9:16 em cortes de 90 s), tiktok ou yt (padrão: full)
# DRIVE_AUTO_PRESET=full
# segundos entre uma olhada e outra na pasta (padrão: 60; mínimo: 5)
# DRIVE_AUTO_INTERVAL=60
# aviso no Telegram quando um vídeo termina: token do bot (é uma senha: nunca mande para ninguém) e o número do chat
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# quem avisa: drive (só os vídeos da pasta do Drive, padrão) ou all (todos)
# TELEGRAM_NOTIFY=drive
