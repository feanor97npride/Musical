THEME_API_KEY=
THEME_MODEL=claude-haiku-5-5
WHISPER_MODEL=small
# web: senha que a página pede (vazio = sem senha, só para uso local)
ACCESS_TOKEN=
# web: sites que podem chamar o servidor de outro endereço, separados por vírgula (ex.: a página na Vercel)
ALLOWED_ORIGINS=
# iniciador (Windows): endereço fixo do site na Vercel, sem barra no final (ex.: https://seu-site.vercel.app)
SITE_URL=
# iniciador: porta do servidor local (padrão 8000)
# PORT=8000
